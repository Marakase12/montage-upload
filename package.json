{
  "name": "montage-upload-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chunked large-file uploader for the montage workspace",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "worker:dev": "npx wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "npx wrangler deploy --config worker/wrangler.jsonc"
  },
  "engines": {
    "node": ">=20"
  }
}

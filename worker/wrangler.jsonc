{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "montage-upload-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "montage-uploads"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://YOUR-GITHUB-NAME.github.io",
    "PUBLIC_SITE_URL": "https://YOUR-GITHUB-NAME.github.io/YOUR-REPOSITORY/",
    "MAX_FILE_SIZE_BYTES": "21474836480",
    "CHUNK_SIZE_BYTES": "10485760",
    "DIRECT_FILE_LIMIT_BYTES": "20971520"
  }
}
